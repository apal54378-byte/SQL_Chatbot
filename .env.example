GROQ_API_KEY=your_groq_api_key_here
DB_USER=postgres
DB_PASSWORD=your_password_here
# Use localhost when running locally.
# When running in Docker, pass DB_HOST=host.docker.internal (e.g. via `docker run -e`)
# or see the Dockerfile, which sets it by default.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_data_assistant
